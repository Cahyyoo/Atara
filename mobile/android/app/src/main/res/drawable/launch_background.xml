<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The page colour the Flutter splash starts on, so the handoff to the
         first frame is seamless. -->
    <item android:drawable="@color/splash_background" />
    <!-- And the app icon on top of it. Never an empty window: a blank field
         for however long the app takes to boot - seconds, on a debug build -
         reads as a frozen app. The whole icon rather than its foreground,
         because the foreground is a white mountain and would vanish on this
         light ground. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
