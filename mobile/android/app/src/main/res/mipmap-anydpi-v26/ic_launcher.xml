<?xml version="1.0" encoding="utf-8"?>
<!-- From API 26 the launcher masks the icon to its own shape, so the olive
     gradient is a background layer and the flask is drawn on top with room
     around it. Below API 26 the PNGs in the mipmap folders are used instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
