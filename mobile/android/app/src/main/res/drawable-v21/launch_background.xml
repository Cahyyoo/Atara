<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brand ground, matching the first stop of the Flutter splash's
         gradient, so the handoff to the first frame is invisible. -->
    <item android:drawable="@color/splash_background" />
    <!-- And the mark on top of it. This used to be deliberately empty, to
         stop the mountain being drawn twice – once by the system and again
         by Dart. The cost of that was a blank teal field for however long the
         app took to boot, which on a debug build is seconds. The Flutter
         splash now starts with the mark already in place instead, so the two
         line up and nothing is ever blank. -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
