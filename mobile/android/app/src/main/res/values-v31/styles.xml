<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From API 31 the platform draws the splash itself and windowBackground
         is ignored. Leaving windowSplashScreenAnimatedIcon unset is what we
         want: the platform falls back to the launcher's adaptive icon, which
         is already the mountain on the brand teal. An earlier version pointed
         it at a transparent drawable to avoid drawing the mountain twice, and
         that turned the whole pre-Flutter window into a blank teal field. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
