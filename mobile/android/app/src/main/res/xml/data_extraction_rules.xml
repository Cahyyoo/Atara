<?xml version="1.0" encoding="utf-8"?>
<!--
  The app keeps a bearer token and a queue of unsent scans in shared_preferences.
  Neither should leave the device in a backup or a device-to-device transfer: a
  backup is readable in places the app's own sandbox is not, and a restored queue
  would replay scans from another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
