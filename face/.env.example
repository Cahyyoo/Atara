# Bind address. Loopback only -- this service must never be reachable from the
# network. The web application is what faces users; this sits behind it.
FACE_HOST=127.0.0.1
FACE_PORT=8001

# Shared secret between the Next.js server and this service. The browser never
# sees it: frames travel browser -> Next.js -> here.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FACE_SERVICE_TOKEN=change-me

# Where the .dat weights live, relative to this file.
FACE_MODEL_DIR=models
