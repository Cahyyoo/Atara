# Pool per Node process. Prisma's default is 2*cores+1 (9 on a 4-core box),
# and one dashboard render alone fans out 11 queries. 25 leaves room for a
# second process against MySQL's max_connections (151 by default).
# pool_timeout=5: a request that cannot get a connection fails fast into a
# 503 with Retry-After instead of holding a scan for 10 s and then 500-ing.
DATABASE_URL="mysql://root:password@localhost:3306/atara?connection_limit=25&pool_timeout=5&connect_timeout=5"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Set to 1 only when a reverse proxy in front of this app appends
# x-forwarded-for itself. Otherwise the sign-in rate limiter would trust a
# header the client can set, and could be bypassed by varying it.
TRUST_PROXY="0"

# Whether the site is served over HTTPS. "1": the session cookie is Secure and
# HSTS + upgrade-insecure-requests are sent. "0": a plain-HTTP server (e.g. a
# local/LAN box at http://192.168.x.x). Unset: the cookie follows each request
# (Secure over https, or x-forwarded-proto=https with TRUST_PROXY=1), and the
# headers assume HTTPS in production. The headers are read at `next build`, so
# rebuild after changing it. The camera (face sign-in) still needs HTTPS or
# localhost.
APP_HTTPS=""

# The sub-path when a reverse proxy serves the app under one, e.g. "/atara" for
# http://host/atara. Empty when the app owns the whole origin. Fixed at
# `next build`: rebuild after changing it. The proxy must forward the path
# with the prefix intact (Caddy: `handle /atara*`, not `handle_path`).
NEXT_PUBLIC_BASE_PATH=""

# The dlib face service in ../face. Loopback only; it refuses anything else.
# The token must be the same value as FACE_SERVICE_TOKEN in face/.env.
FACE_SERVICE_URL="http://127.0.0.1:8001"
FACE_SERVICE_TOKEN="change-me"

# Seals each account's authenticator (TOTP) secret before it is stored, so a
# copy of the users table alone cannot produce codes. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates every authenticator already set up; admins would
# have to reset them from the Users page.
MFA_ENCRYPTION_KEY=""
