// Eksplorasi module: the assay data source and its QC samples.

/// What a row of the data source is: a field sample, or one of the three
/// QC checks laid among them.
enum SampleType {
  FIELD
  STANDARD
  BLANK
  DUPLICATE
}

/// One assayed sample. The values are kept as the lab wrote them (varchar):
/// a result such as "<0.01" is a result, not a number, and is only left out
/// of the charts. A DUPLICATE names the sample it repeats in `control`.
model DataSource {
  id          String     @id @default(cuid())
  controlDate String?    @map("control_date") @db.VarChar(50)
  /// The CRM a STANDARD is, or the sample a DUPLICATE repeats.
  control     String?    @db.VarChar(100)
  campaign    String?    @db.VarChar(100)
  no          String?    @db.VarChar(50)
  holeId      String?    @map("hole_id") @db.VarChar(50)
  sampleId    String     @unique @map("sample_id") @db.VarChar(50)
  sampleType  SampleType @map("sample_type")
  from        String?    @db.VarChar(20)
  to          String?    @db.VarChar(20)
  /// The Duplicate list's Remarks: about the original sample the duplicate repeats.
  originalSampleIdRemarks String? @map("original_sample_id_remarks") @db.VarChar(500)
  /// The Remarks of the Data Source, Standard and Blank lists (the OREAS standards' notes).
  oreasRemarks            String? @map("oreas_remarks") @db.VarChar(500)
  date        DateTime?  @db.Date
  weight      String?    @db.VarChar(20)

  ni    String? @db.VarChar(20)
  fe    String? @db.VarChar(20)
  fe2o3 String? @db.VarChar(20)
  co    String? @db.VarChar(20)
  na2o  String? @db.VarChar(20)
  mgo   String? @db.VarChar(20)
  al2o3 String? @db.VarChar(20)
  sio2  String? @db.VarChar(20)
  p2o5  String? @db.VarChar(20)
  so3   String? @db.VarChar(20)
  k2o   String? @db.VarChar(20)
  cao   String? @db.VarChar(20)
  tio2  String? @db.VarChar(20)
  cr2o3 String? @db.VarChar(20)
  mno   String? @db.VarChar(20)
  mc    String? @db.VarChar(20)

  createdById String   @map("created_by")
  createdBy   User     @relation("DataSourceCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation("DataSourceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sampleType, date])
  @@index([control])
  @@index([campaign])
  @@index([holeId])
  @@map("eksplorasi_data_source")
}
