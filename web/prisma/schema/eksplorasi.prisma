// Eksplorasi module: drill holes.

enum DrillHoleStatus {
  PLANNED
  ONGOING
  COMPLETED
  ABANDONED
}

/// One drill hole: where it is, which way it points, how deep it went.
/// Deliberately minimal for now; intervals, logs and assays come later.
model DrillHole {
  id         String          @id @default(cuid())
  holeId     String          @unique @map("hole_id") @db.VarChar(50)
  /// Prospect or block.
  area       String?         @db.VarChar(100)
  easting    Decimal?        @db.Decimal(12, 3)
  northing   Decimal?        @db.Decimal(12, 3)
  elevation  Decimal?        @db.Decimal(8, 2)
  azimuth    Decimal?        @db.Decimal(5, 2)
  dip        Decimal?        @db.Decimal(5, 2)
  totalDepth Decimal?        @map("total_depth") @db.Decimal(8, 2)
  status     DrillHoleStatus @default(PLANNED)
  startDate  DateTime?       @map("start_date") @db.Date
  endDate    DateTime?       @map("end_date") @db.Date
  remarks    String?         @db.Text

  createdById String   @map("created_by")
  createdBy   User     @relation("DrillHoleCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation("DrillHoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([area])
  @@map("drill_holes")
}
