// Shared: the generator, the database, and what every module stands on --
// accounts, roles and departments, sessions, the sign-in trail, the face
// second factor. Prisma reads every .prisma file in this folder as one schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Who may do what is decided in src/core/lib/auth/permissions.ts and each
/// module's capabilities.ts, not here.
///
/// A role means something only together with the department: ADMIN in LAB
/// runs the lab module, ADMIN in EKSPLORASI runs the exploration module.
/// SUPER_ADMIN belongs to no department and manages the department admins.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  DATABASE
  ANALISIS
  PREPARATOR
}

/// The sub-sections of the app. Each one is a module with its own pages.
enum Department {
  LAB
  EKSPLORASI
}

model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  password   String
  role       UserRole    @default(PREPARATOR)
  /// Null only for SUPER_ADMIN. See isValidAccess in src/lib/permissions.ts.
  department Department?
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now())

  /// Consecutive failed sign-ins; reset on success.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Set once the attempt limit is hit; sign-in is refused until it passes.
  lockedUntil         DateTime? @map("locked_until")

  /// When this person agreed to their face being enrolled, and who took it.
  ///
  /// UU PDP No. 27/2022 treats biometrics as specific personal data, which
  /// needs consent that is explicit and separate rather than folded into
  /// signing up. Kept beside the enrolments rather than assumed from their
  /// existence, so withdrawing it is a thing that can be recorded.
  faceConsentAt   DateTime? @map("face_consent_at")
  faceConsentById String?   @map("face_consent_by")
  faceConsentBy   User?     @relation("FaceConsentTakenBy", fields: [faceConsentById], references: [id])

  /// The authenticator-app second factor (TOTP, RFC 6238), the alternative
  /// to the face step.
  ///
  /// The secret is sealed with MFA_ENCRYPTION_KEY before it is written, so a
  /// copy of this table alone cannot mint codes. It never leaves the server
  /// except once, as the QR code the person scans on their own phone.
  totpSecret        String?   @map("totp_secret") @db.VarChar(255)
  /// An admin asked for an authenticator; the person sets it up themselves at
  /// their next sign-in. The admin never sees the secret.
  totpRequestedAt   DateTime? @map("totp_requested_at")
  totpRequestedById String?   @map("totp_requested_by")
  totpRequestedBy   User?     @relation("TotpRequestedBy", fields: [totpRequestedById], references: [id])
  /// Set when the first code was accepted: from here on the factor is live.
  totpEnabledAt     DateTime? @map("totp_enabled_at")
  /// The last 30-second step a code was accepted for, so the same code cannot
  /// be used twice while it is still on the screen.
  totpLastUsedStep  Int?      @map("totp_last_used_step")

  /// When this person finished (or skipped) the welcome guide. Kept on the
  /// account, not the browser, so it is shown once per person.
  guideSeenAt DateTime? @map("guide_seen_at")

  /// Set when an administrator chose this password -- a new account, or a
  /// reset -- so the person replaces it on their next sign-in on the web,
  /// before anything else. Cleared when they do.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  createdSamples       Sample[]              @relation("SampleCreatedBy")
  deletedSamples       Sample[]              @relation("SampleDeletedBy")
  sampleLogs           SampleLog[]           @relation("SampleLogPreparator")
  labRecordEdits       LabRecord[]           @relation("LabRecordUpdatedBy")
  labRecordAudits      LabRecordAudit[]      @relation("LabRecordAuditUser")
  faceEnrollments      FaceEnrollment[]      @relation("FaceEnrollmentUser")
  faceEnrolled         FaceEnrollment[]      @relation("FaceEnrollmentTakenBy")
  faceConsentFor       User[]                @relation("FaceConsentTakenBy")
  totpRequestedFor     User[]                @relation("TotpRequestedBy")
  signInAudits         SignInAudit[]         @relation("SignInAuditUser")
  sessions             UserSession[]         @relation("UserSessionUser")
  announcements        Announcement[]        @relation("AnnouncementAuthor")
  rolePasswordsSet     RolePasswordDefault[] @relation("RolePasswordDefaultSetBy")
  dataSourcesCreated   DataSource[]          @relation("DataSourceCreatedBy")
  dataSourcesUpdated   DataSource[]          @relation("DataSourceUpdatedBy")
  crmStandardsCreated  CrmStandard[]         @relation("CrmStandardCreatedBy")
  crmStandardsUpdated  CrmStandard[]         @relation("CrmStandardUpdatedBy")
  crmBlanksCreated     CrmBlank[]            @relation("CrmBlankCreatedBy")
  crmBlanksUpdated     CrmBlank[]            @relation("CrmBlankUpdatedBy")
  crmDuplicatesCreated CrmDuplicate[]        @relation("CrmDuplicateCreatedBy")
  crmDuplicatesUpdated CrmDuplicate[]        @relation("CrmDuplicateUpdatedBy")

  @@index([department, role])
  @@map("core_users")
}

/// Which slot a session occupies. One of each per account at a time.
enum SessionClient {
  WEB
  MOBILE
}

/// Why a session stopped being valid before its token expired.
enum SessionEndReason {
  /// The same account signed in on another device in the same slot.
  REPLACED
  /// Signed out on purpose.
  LOGOUT
  /// An administrator ended it: from the sessions list, or by resetting the
  /// account's password.
  ADMIN_ENDED
  /// The account's owner changed their password on another device.
  PASSWORD_CHANGED
}

/// A signed-in device.
///
/// Tokens used to carry everything and the server kept nothing, so a token
/// could not be withdrawn and an account could be open on any number of
/// devices at once. Each token now names one of these rows, and a request is
/// only good while its row has not ended -- which is what lets a sign-in on a
/// new device end the old one, and tell the old one why.
model UserSession {
  id     String        @id @default(cuid())
  userId String        @map("user_id")
  user   User          @relation("UserSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  client SessionClient

  /// One neutral line, "Windows 11 · Microsoft Edge 129", for anything that
  /// cannot render deviceInfo -- an older app build, somebody reading the table.
  device     String? @db.VarChar(120)
  /// What the device was, as data (see DeviceInfo in session-client.ts), so the
  /// device that is signed out can say it in its own language.
  deviceInfo Json?   @map("device_info")
  /// As on SignInAudit: null unless the deployment can vouch for it.
  address    String? @db.VarChar(64)

  createdAt    DateTime          @default(now()) @map("created_at")
  endedAt      DateTime?         @map("ended_at")
  endedReason  SessionEndReason? @map("ended_reason")
  /// The session that took this one's place, when endedReason is REPLACED.
  replacedById String?           @map("replaced_by")

  /// "Is anybody else signed in in this slot?": asked at every sign-in.
  @@index([userId, client, endedAt])
  @@map("core_user_sessions")
}

/// How a sign-in attempt ended.
///
/// The distinction that carries the weight is PASSWORD_ONLY against
/// FACE_VERIFIED: one says a password was enough, the other says a face was
/// checked and matched. Without that difference recorded, "who signed in" and
/// "who proved it was them" are the same sentence, and they are not.
enum SignInOutcome {
  /// The password was wrong on an account that exists.
  PASSWORD_FAILED
  /// Refused before the password was even considered.
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE
  /// Signed in on the password alone, because no face is enrolled.
  PASSWORD_ONLY
  /// The camera produced nothing usable: no face, poor framing, no blink.
  FACE_UNREADABLE
  /// A face was read and it was not this person's.
  FACE_MISMATCH
  /// The dlib service did not answer, so no session was issued.
  FACE_SERVICE_DOWN
  /// Password and face, both.
  FACE_VERIFIED
  /// Password and an authenticator code, set up in this same sign-in.
  TOTP_ENROLLED
  /// Password and an authenticator code.
  TOTP_VERIFIED
  /// An authenticator code was entered and it was wrong, or already used.
  TOTP_MISMATCH
  /// A sign-in on another device ended this account's session in that slot.
  SESSION_REPLACED
  /// The account's owner changed their own password.
  PASSWORD_CHANGED
  /// An administrator ended one or more of this account's sessions.
  SESSION_ENDED_BY_ADMIN
}

/// Every sign-in attempt against a real account.
///
/// This is the record that makes the face step worth having. A session cookie
/// proves somebody held a password; only this says whether a face was checked
/// as well, and it is the difference between "this account did it" and "this
/// person did it".
///
/// Attempts against addresses that match no account are deliberately absent.
/// They are not events in anybody's history, the rate limiter already bounds
/// them, and recording what was typed would eventually write somebody's
/// password into this table -- people do type them into the email field.
model SignInAudit {
  id      String        @id @default(cuid())
  userId  String        @map("user_id")
  user    User          @relation("SignInAuditUser", fields: [userId], references: [id], onDelete: Cascade)
  outcome SignInOutcome

  /// True only when a face was compared and matched. Never inferred from the
  /// outcome, so a new outcome cannot quietly start meaning "verified".
  faceVerified Boolean @default(false) @map("face_verified")

  /// True only when an authenticator code was checked and accepted. Stored
  /// for the same reason as faceVerified.
  totpVerified Boolean @default(false) @map("totp_verified")

  /// The caller's address, when the deployment can vouch for one.
  ///
  /// Null whenever TRUST_PROXY is unset, because x-forwarded-for is the
  /// caller's to write and a field that quietly lies is worse than one that
  /// admits it does not know.
  address String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  /// The trail's per-outcome summary and its outcome filter.
  @@index([outcome, createdAt])
  @@map("core_sign_in_audits")
}

/// One enrolled face for one account.
///
/// Several per person on purpose: a single frame only recognises the lighting
/// it was taken in. The descriptor is the 128 float32 values dlib's recognition
/// network produces, stored as their raw 512 bytes rather than as JSON --
/// exact, and a quarter the size.
///
/// At sign-in it never reaches a browser: frames go to the server, a session
/// comes back, and the comparison happens in between. A descriptor is a
/// replayable credential, so one computed in a browser could be captured once
/// and posted forever after without a camera. Enrolment is the exception, and
/// only because an admin doing it can already write descriptors into any
/// account through the route below.
model FaceEnrollment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation("FaceEnrollmentUser", fields: [userId], references: [id], onDelete: Cascade)
  /// 128 float32 values: 512 bytes exactly.
  descriptor  Bytes
  createdAt   DateTime @default(now()) @map("created_at")
  /// The admin who ran the enrolment, for the same reason every other write here is attributed.
  createdById String   @map("created_by")
  createdBy   User     @relation("FaceEnrollmentTakenBy", fields: [createdById], references: [id])

  @@index([userId])
  @@map("core_face_enrollments")
}

/// A face or authenticator challenge that has already been spent.
///
/// The nonce is the primary key, and that is the whole mechanism: the first
/// insert wins and the second fails in the database, atomically. It replaces a
/// Map held in one process, which could only promise "exactly once" to that
/// one process -- run a second worker and a captured challenge could be spent
/// again on it, with nothing to report that it had been.
///
/// Rows outlive their challenge by design and are swept as they are passed.
/// Keeping them a little longer than the two-minute window is harmless; losing
/// one early is not, so the sweep is by expiry rather than by age.
model SpentChallenge {
  nonce     String   @id
  /// When this may be forgotten: issued-at plus the challenge lifetime.
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("core_spent_challenges")
}
